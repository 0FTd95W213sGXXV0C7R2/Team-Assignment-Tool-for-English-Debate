
{
  "name": "team-assignment-tool-for-english-debate",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "debate-motion-backups"
    }
  ],
  "triggers": {
    "crons": ["0 18 * * *"]
  }
}
